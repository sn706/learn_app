        {
            "type": "TITLE",
            "content": "[{\"text\":\"പ്രധാന പോയിന്റുകൾ \"}]",
            "fontSize": 22,
            "fontPath": "fonts\/MLU-Karthika Bold.ttf",
            "textColor": "gradient:#141E30:#243B55",
            "backgroundColor": "#FFFFFF",
            "borderColor": "gradient:#11998e:#38ef7d",
            "textAlignment": "CENTER",
            "isUnderlined": false,
            "isTextUnderlined": false
        },
        {
            "type": "PARAGRAPH",
            "content": "[{\"text\":\"മിശ്രിതങ്ങൾ (Mixtures):\",\"bold\":true},{\"text\":\" ഒന്നിലധികം വസ്തുക്കൾ (ഘടകങ്ങൾ) ചേർന്നുണ്ടാകുന്ന പദാർഥങ്ങളാണ് മിശ്രിതങ്ങൾ (ഉദാഹരണത്തിന്: സാലഡ്, മാങ്ങ അച്ചാർ, കോൺക്രീറ്റ്, കമ്പോസ്റ്റ്, മിക്സ്‌ചർ).\\n\\n\"}]",
            "fontSize": 11,
            "fontPath": "fonts\/MLU-Karthika.ttf",
            "textColor": "#B71C1C",
            "backgroundColor": "#FFFFFF",
            "borderColor": "gradient:#D8B4FE:#F472B6",
            "textAlignment": "LEFT",
            "isUnderlined": false,
            "isTextUnderlined": false,
            "borderRadius": 25
        },
        {
            "type": "PARAGRAPH",
            "content": "[{\"text\":\"ഘടകങ്ങളുടെ പ്രാധാന്യം:\",\"bold\":true},{\"text\":\" ആഹാരം രുചികരമാക്കാനും മറ്റും ചേര്‍ക്കുന്ന ഘടകങ്ങള്‍ക്കും അവ ചേര്‍ക്കേണ്ട അളവിനും വലിയ പ്രാധാന്യമുണ്ട്.\\n\\n\"}]",
            "fontSize": 11,
            "fontPath": "fonts\/MLU-Karthika.ttf",
            "textColor": "#B71C1C",
            "backgroundColor": "#FFFFFF",
            "borderColor": "gradient:#D8B4FE:#F472B6",
            "textAlignment": "LEFT",
            "isUnderlined": false,
            "isTextUnderlined": false,
            "borderRadius": 25
        },
        {
            "type": "PARAGRAPH",
            "content": "[{\"text\":\"പരീക്ഷണങ്ങൾ:\",\"bold\":true},{\"text\":\" ശാസ്ത്രകിറ്റിലെ സാമഗ്രികളും മറ്റ് വസ്തുക്കളും (ഉപ്പ്, പഞ്ചസാര, ചോക്കുപൊടി, നാരങ്ങ, തുരിശ്, പൊട്ടാസ്യം പെർമാംഗനേറ്റ്, ഇരുമ്പുപൊടി, റവ, പയർ മുതലായവ) ഉപയോഗിച്ച് വിവിധതരം മിശ്രിതങ്ങൾ നിർമ്മിക്കാൻ സാധിക്കും.\\n\\n\"}]",
            "fontSize": 11,
            "fontPath": "fonts\/MLU-Karthika.ttf",
            "textColor": "#B71C1C",
            "backgroundColor": "#FFFFFF",
            "borderColor": "gradient:#D8B4FE:#F472B6",
            "textAlignment": "LEFT",
            "isUnderlined": false,
            "isTextUnderlined": false,
            "borderRadius": 25
        },
        {
            "type": "PARAGRAPH",
            "content": "[{\"text\":\"മിശ്രിതങ്ങളിലെ വൈവിധ്യം\",\"bold\":true},{\"text\":\"\\n\\n📍 ​ദ്രാവകത്തിൽ ഖരവസ്തു അലിഞ്ഞുചേർന്നവ (ഉദാ: ഉപ്പുവെള്ളം).\\n📍 ഖരവസ്തുക്കൾ മാത്രം ചേർന്നവ (ഉദാ: റവയും ഉപ്പും കലർന്നത്).\\n📍 ഒന്നിൽ കൂടുതൽ ഖരവസ്തുക്കൾ ദ്രാവകത്തിൽ ലയിച്ചുചേർന്നവ (ഉദാ: പൊട്ടാസ്യം പെർമാംഗനേറ്റും ഉപ്പും വെള്ളത്തിൽ ലയിച്ചത്).\\n📍 എല്ലാ ഘടകങ്ങളും എളുപ്പത്തിൽ കാണാൻ കഴിയുന്ന മിശ്രിതങ്ങളും (ഉദാ: ചോക്കുപൊടി കലർത്തിയ വെള്ളം), ഘടകങ്ങൾ പ്രത്യേകം കാണാൻ കഴിയാത്ത ലായനികളും ഇതിൽ ഉൾപ്പെടുന്നു.\\n\\n\"}]",
            "fontSize": 20,
            "fontPath": "fonts\/MLU-Karthika.ttf",
            "textColor": "#B71C1C",
            "backgroundColor": "#FFFFFF",
            "borderColor": "gradient:#D8B4FE:#F472B6",
            "textAlignment": "LEFT",
            "isUnderlined": false,
            "isTextUnderlined": false,
            "borderRadius": 25
        }
    ]
