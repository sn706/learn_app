[
  {
    "chapterNo": 4,
    "chapterTitle": "പ്രകാശം പ്രതിപതിക്കുമ്പോൾ",
    "classLevel": 7,
    "dynamicContentJson": "[]",
    "guideFullNotesHtml": "\u003c!DOCTYPE html\u003e\n\u003chtml lang\u003d\"ml\"\u003e\n\u003chead\u003e\n    \u003cmeta charset\u003d\"UTF-8\"\u003e\n    \u003cmeta name\u003d\"viewport\" content\u003d\"width\u003ddevice-width, initial-scale\u003d1.0\"\u003e\n    \u003ctitle\u003eപരിസ്ഥിതി ദിനം - Green Earth Simulation\u003c/title\u003e\n    \u003cstyle\u003e\n        body {\n            font-family: Arial, sans-serif;\n            background-color: #f0f7f4;\n            margin: 0;\n            padding: 20px;\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n        }\n        h2 {\n            color: #27ae60;\n            margin-bottom: 5px;\n            text-align: center;\n        }\n        p.sub {\n            color: #555;\n            font-size: 14px;\n            margin-bottom: 15px;\n            text-align: center;\n        }\n        .container {\n            background: white;\n            padding: 20px;\n            border-radius: 10px;\n            box-shadow: 0 4px 10px rgba(0,0,0,0.1);\n            max-width: 600px;\n            width: 100%;\n        }\n        canvas {\n            background: #e8f8f5;\n            border: 2px solid #a3e4d7;\n            border-radius: 5px;\n            display: block;\n            margin: 0 auto;\n            max-width: 100%;\n        }\n        .controls {\n            margin-top: 15px;\n            text-align: center;\n        }\n        label {\n            font-weight: bold;\n            color: #2c3e50;\n        }\n        input[type\u003d\"range\"] {\n            width: 80%;\n            margin-top: 10px;\n            cursor: pointer;\n        }\n        .stats {\n            display: flex;\n            justify-content: space-around;\n            margin-top: 15px;\n            background: #e8f8f5;\n            padding: 10px;\n            border-radius: 5px;\n            font-size: 14px;\n            font-weight: bold;\n            color: #16a085;\n        }\n        .info {\n            margin-top: 10px;\n            font-size: 14px;\n            color: #34495e;\n            text-align: center;\n            background: #f9e79f;\n            padding: 8px;\n            border-radius: 5px;\n        }\n    \u003c/style\u003e\n\u003c/head\u003e\n\u003cbody\u003e\n\n\u003cdiv class\u003d\"container\"\u003e\n    \u003ch2\u003eലോക പരിസ്ഥിതി ദിനം (World Environment Day)\u003c/h2\u003e\n    \u003cp class\u003d\"sub\"\u003eമരങ്ങൾ വെച്ചുപിടിപ്പിച്ച് ഭൂമിയെ ഹരിതാഭമാക്കൂ!\u003c/p\u003e\n    \n    \u003ccanvas id\u003d\"earthCanvas\" width\u003d\"500\" height\u003d\"300\"\u003e\u003c/canvas\u003e\n    \n    \u003cdiv class\u003d\"controls\"\u003e\n        \u003clabel for\u003d\"treeSlider\"\u003eമരങ്ങളുടെ എണ്ണം: \u003cspan id\u003d\"treeVal\"\u003e10\u003c/span\u003e%\u003c/label\u003e\u003cbr\u003e\n        \u003cinput type\u003d\"range\" id\u003d\"treeSlider\" min\u003d\"0\" max\u003d\"100\" value\u003d\"10\"\u003e\n    \u003c/div\u003e\n\n    \u003cdiv class\u003d\"stats\"\u003e\n        \u003cdiv\u003eഓക്സിജൻ ($O_2$): \u003cspan id\u003d\"oxyVal\"\u003e30\u003c/span\u003e%\u003c/div\u003e\n        \u003cdiv\u003eതാപനില: \u003cspan id\u003d\"tempVal\"\u003e38\u003c/span\u003e°C\u003c/div\u003e\n        \u003cdiv\u003eമലിനീകരണം: \u003cspan id\u003d\"pollVal\"\u003e90\u003c/span\u003e%\u003c/div\u003e\n    \u003c/div\u003e\n\n    \u003cdiv class\u003d\"info\" id\u003d\"infoText\"\u003e\n        ഭൂമിയിൽ മരങ്ങൾ കുറവായതിനാൽ മലിനീകരണവും ചൂടും കൂടുതലാണ്.\n    \u003c/div\u003e\n\u003c/div\u003e\n\n\u003cscript\u003e\n    const canvas \u003d document.getElementById(\u0027earthCanvas\u0027);\n    const ctx \u003d canvas.getContext(\u00272d\u0027);\n    const treeSlider \u003d document.getElementById(\u0027treeSlider\u0027);\n    const treeVal \u003d document.getElementById(\u0027treeVal\u0027);\n    const oxyVal \u003d document.getElementById(\u0027oxyVal\u0027);\n    const tempVal \u003d document.getElementById(\u0027tempVal\u0027);\n    const pollVal \u003d document.getElementById(\u0027pollVal\u0027);\n    const infoText \u003d document.getElementById(\u0027infoText\u0027);\n\n    function drawScene(percentage) {\n        ctx.clearRect(0, 0, canvas.width, canvas.height);\n\n        // 1. Draw Sky (changes from grey/polluted to bright blue based on trees)\n        let skyBlue \u003d Math.floor(180 + (percentage * 0.75));\n        ctx.fillStyle \u003d `rgb(200, 220, ${skyBlue})`;\n        ctx.fillRect(0, 0, canvas.width, 200);\n\n        // 2. Draw Ground (changes from dry brown to lush green)\n        let groundGreen \u003d Math.floor(100 + (percentage * 1.3));\n        let groundRed \u003d Math.floor(180 - (percentage * 1.2));\n        ctx.fillStyle \u003d `rgb(${groundRed}, ${groundGreen}, 50)`;\n        ctx.fillRect(0, 200, canvas.width, 100);\n\n        // 3. Draw Sun / Clouds based on percentage\n        if (percentage \u003c 40) {\n            // Hot Red Sun \u0026 Smog\n            ctx.fillStyle \u003d \"#e74c3c\";\n            ctx.beginPath();\n            ctx.arc(420, 60, 30, 0, 2 * Math.PI);\n            ctx.fill();\n            // Smog clouds\n            ctx.fillStyle \u003d \"rgba(120, 120, 120, 0.5)\";\n            ctx.fillRect(50, 40, 400, 30);\n        } else {\n            // Friendly Yellow Sun \u0026 Clean white clouds\n            ctx.fillStyle \u003d \"#f1c40f\";\n            ctx.beginPath();\n            ctx.arc(420, 60, 30, 0, 2 * Math.PI);\n            ctx.fill();\n            // White clouds\n            ctx.fillStyle \u003d \"rgba(255, 255, 255, 0.8)\";\n            ctx.beginPath();\n            ctx.arc(100, 50, 20, 0, 2 * Math.PI);\n            ctx.arc(125, 40, 25, 0, 2 * Math.PI);\n            ctx.arc(150, 50, 20, 0, 2 * Math.PI);\n            ctx.fill();\n        }\n\n        // 4. Draw Trees based on slider percentage\n        let numTrees \u003d Math.floor((percentage / 100) * 12);\n        let spacing \u003d canvas.width / (numTrees + 1);\n\n        for (let i \u003d 1; i \u003c\u003d numTrees; i++) {\n            let x \u003d spacing * i;\n            let y \u003d 200;\n\n            // Tree Trunk\n            ctx.fillStyle \u003d \"#795548\";\n            ctx.fillRect(x - 6, y - 40, 12, 40);\n\n            // Tree Leaves (Green Canopy)\n            ctx.fillStyle \u003d \"#2e7d32\";\n            ctx.beginPath();\n            ctx.arc(x, y - 50, 22, 0, 2 * Math.PI);\n            ctx.fill();\n        }\n\n        // Update Text Stats\n        treeVal.innerText \u003d percentage;\n        let oxygen \u003d Math.floor(20 + (percentage * 0.8));\n        let temp \u003d Math.floor(40 - (percentage * 0.15));\n        let pollution \u003d Math.floor(100 - percentage);\n\n        oxyVal.innerText \u003d oxygen + \"%\";\n        tempVal.innerText \u003d temp + \"°C\";\n        pollVal.innerText \u003d pollution + \"%\";\n\n        // Update Messages\n        if (percentage \u003c 30) {\n            infoText.innerText \u003d \"⚠️ മുന്നറിയിപ്പ്: മരങ്ങളുടെ കുറവ് മൂലം അന്തരീക്ഷ മലിനീകരണവും ചൂടും വർദ്ധിച്ചിരിക്കുന്നു!\";\n            infoText.style.background \u003d \"#f9e79f\";\n        } else if (percentage \u003c 70) {\n            infoText.innerText \u003d \"🌱 നല്ല തുടക്കം! കൂടുതൽ മരങ്ങൾ വെച്ചുപിടിപ്പിച്ചാൽ പരിസ്ഥിതി കൂടുതൽ സുരക്ഷിതമാകും.\";\n            infoText.style.background \u003d \"#d4efdf\";\n        } else {\n            infoText.innerText \u003d \"অভિનന്ദനങ്ങൾ! 🌍 ഹരിതാഭമായ ഭൂമി: ശുദ്ധമായ വായുവും തണുത്ത കാലാവസ്ഥയും ഉറപ്പാക്കപ്പെട്ടു.\";\n            infoText.style.background \u003d \"#a9dfbf\";\n        }\n    }\n\n    // Event listener for slider\n    treeSlider.addEventListener(\u0027input\u0027, (e) \u003d\u003e {\n        drawScene(e.target.value);\n    });\n\n    // Initial draw\n    drawScene(treeSlider.value);\n\u003c/script\u003e\n\n\u003c/body\u003e\n\u003c/html\u003e",
