                                                    "text": "<p dir=\"ltr\">&#3370;&#3405;&#3376;&#3349;&#3390;&#3382;&#3374;&#3378;&#3391;&#3368;&#3392;&#3349;&#3376;&#3363;&#3364;&#3405;&#3364;&#3398;&#3349;&#3405;&#3349;&#3393;&#3377;&#3391;&#3354;&#3405;&#3354;&#3405; &#3333;&#3381;&#3372;&#3403;&#3367;&#3330; &#3368;&#3399;&#3359;&#3393;&#3368;&#3405;&#3368;&#3393;.<br>\n<\/p>\n<p dir=\"ltr\"><br>\n<\/p>"
