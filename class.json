    "dynamicContentJson": "[]",
    "guideFullNotesHtml": "<!DOCTYPE html>\n<html lang=\"ml\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>പരിസ്ഥിതി ദിനം - Green Earth Simulation</title>\n    <style>\n        body {\n            font-family: Arial, sans-serif;\n            background-color: #f0f7f4;\n            margin: 0;\n            padding: 20px;\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n        }\n        h2 {\n            color: #27ae60;\n            margin-bottom: 5px;\n            text-align: center;\n        }\n        p.sub {\n            color: #555;\n            font-size: 14px;\n            margin-bottom: 15px;\n            text-align: center;\n        }\n        .container {\n            background: white;\n            padding: 20px;\n            border-radius: 10px;\n            box-shadow: 0 4px 10px rgba(0,0,0,0.1);\n            max-width: 600px;\n            width: 100%;\n        }\n        canvas {\n            background: #e8f8f5;\n            border: 2px solid #a3e4d7;\n            border-radius: 5px;\n            display: block;\n            margin: 0 auto;\n            max-width: 100%;\n        }\n        .controls {\n            margin-top: 15px;\n            text-align: center;\n        }\n        label {\n            font-weight: bold;\n            color: #2c3e50;\n        }\n        input[type=\"range\"] {\n            width: 80%;\n            margin-top: 10px;\n            cursor: pointer;\n        }\n        .stats {\n            display: flex;\n            justify-content: space-around;\n            margin-top: 15px;\n            background: #e8f8f5;\n            padding: 10px;\n            border-radius: 5px;\n            font-size: 14px;\n            font-weight: bold;\n            color: #16a085;\n        }\n        .info {\n            margin-top: 10px;\n            font-size: 14px;\n            color: #34495e;\n            text-align: center;\n            background: #f9e79f;\n            padding: 8px;\n            border-radius: 5px;\n        }\n    </style>\n</head>\n<body>\n\n<div class=\"container\">\n    <h2>ലോക പരിസ്ഥിതി ദിനം (World Environment Day)</h2>\n    <p class=\"sub\">മരങ്ങൾ വെച്ചുപിടിപ്പിച്ച് ഭൂമിയെ ഹരിതാഭമാക്കൂ!</p>\n    \n    <canvas id=\"earthCanvas\" width=\"500\" height=\"300\"></canvas>\n    \n    <div class=\"controls\">\n        <label for=\"treeSlider\">മരങ്ങളുടെ എണ്ണം: <span id=\"treeVal\">10</span>%</label><br>\n        <input type=\"range\" id=\"treeSlider\" min=\"0\" max=\"100\" value=\"10\">\n    </div>\n\n    <div class=\"stats\">\n        <div>ഓക്സിജൻ ($O_2$): <span id=\"oxyVal\">30</span>%</div>\n        <div>താപനില: <span id=\"tempVal\">38</span>°C</div>\n        <div>മലിനീകരണം: <span id=\"pollVal\">90</span>%</div>\n    </div>\n\n    <div class=\"info\" id=\"infoText\">\n        ഭൂമിയിൽ മരങ്ങൾ കുറവായതിനാൽ മലിനീകരണവും ചൂടും കൂടുതലാണ്.\n    </div>\n</div>\n\n<script>\n    const canvas = document.getElementById('earthCanvas');\n    const ctx = canvas.getContext('2d');\n    const treeSlider = document.getElementById('treeSlider');\n    const treeVal = document.getElementById('treeVal');\n    const oxyVal = document.getElementById('oxyVal');\n    const tempVal = document.getElementById('tempVal');\n    const pollVal = document.getElementById('pollVal');\n    const infoText = document.getElementById('infoText');\n\n    function drawScene(percentage) {\n        ctx.clearRect(0, 0, canvas.width, canvas.height);\n\n        // 1. Draw Sky (changes from grey/polluted to bright blue based on trees)\n        let skyBlue = Math.floor(180 + (percentage * 0.75));\n        ctx.fillStyle = `rgb(200, 220, ${skyBlue})`;\n        ctx.fillRect(0, 0, canvas.width, 200);\n\n        // 2. Draw Ground (changes from dry brown to lush green)\n        let groundGreen = Math.floor(100 + (percentage * 1.3));\n        let groundRed = Math.floor(180 - (percentage * 1.2));\n        ctx.fillStyle = `rgb(${groundRed}, ${groundGreen}, 50)`;\n        ctx.fillRect(0, 200, canvas.width, 100);\n\n        // 3. Draw Sun / Clouds based on percentage\n        if (percentage < 40) {\n            // Hot Red Sun & Smog\n            ctx.fillStyle = \"#e74c3c\";\n            ctx.beginPath();\n            ctx.arc(420, 60, 30, 0, 2 * Math.PI);\n            ctx.fill();\n            // Smog clouds\n            ctx.fillStyle = \"rgba(120, 120, 120, 0.5)\";\n            ctx.fillRect(50, 40, 400, 30);\n        } else {\n            // Friendly Yellow Sun & Clean white clouds\n            ctx.fillStyle = \"#f1c40f\";\n            ctx.beginPath();\n            ctx.arc(420, 60, 30, 0, 2 * Math.PI);\n            ctx.fill();\n            // White clouds\n            ctx.fillStyle = \"rgba(255, 255, 255, 0.8)\";\n            ctx.beginPath();\n            ctx.arc(100, 50, 20, 0, 2 * Math.PI);\n            ctx.arc(125, 40, 25, 0, 2 * Math.PI);\n            ctx.arc(150, 50, 20, 0, 2 * Math.PI);\n            ctx.fill();\n        }\n\n        // 4. Draw Trees based on slider percentage\n        let numTrees = Math.floor((percentage / 100) * 12);\n        let spacing = canvas.width / (numTrees + 1);\n\n        for (let i = 1; i <= numTrees; i++) {\n            let x = spacing * i;\n            let y = 200;\n\n            // Tree Trunk\n            ctx.fillStyle = \"#795548\";\n            ctx.fillRect(x - 6, y - 40, 12, 40);\n\n            // Tree Leaves (Green Canopy)\n            ctx.fillStyle = \"#2e7d32\";\n            ctx.beginPath();\n            ctx.arc(x, y - 50, 22, 0, 2 * Math.PI);\n            ctx.fill();\n        }\n\n        // Update Text Stats\n        treeVal.innerText = percentage;\n        let oxygen = Math.floor(20 + (percentage * 0.8));\n        let temp = Math.floor(40 - (percentage * 0.15));\n        let pollution = Math.floor(100 - percentage);\n\n        oxyVal.innerText = oxygen + \"%\";\n        tempVal.innerText = temp + \"°C\";\n        pollVal.innerText = pollution + \"%\";\n\n        // Update Messages\n        if (percentage < 30) {\n            infoText.innerText = \"⚠️ മുന്നറിയിപ്പ്: മരങ്ങളുടെ കുറവ് മൂലം അന്തരീക്ഷ മലിനീകരണവും ചൂടും വർദ്ധിച്ചിരിക്കുന്നു!\";\n            infoText.style.background = \"#f9e79f\";\n        } else if (percentage < 70) {\n            infoText.innerText = \"🌱 നല്ല തുടക്കം! കൂടുതൽ മരങ്ങൾ വെച്ചുപിടിപ്പിച്ചാൽ പരിസ്ഥിതി കൂടുതൽ സുരക്ഷിതമാകും.\";\n            infoText.style.background = \"#d4efdf\";\n        } else {\n            infoText.innerText = \"অভિનന്ദനങ്ങൾ! 🌍 ഹരിതാഭമായ ഭൂമി: ശുദ്ധമായ വായുവും തണുത്ത കാലാവസ്ഥയും ഉറപ്പാക്കപ്പെട്ടു.\";\n            infoText.style.background = \"#a9dfbf\";\n        }\n    }\n\n    // Event listener for slider\n    treeSlider.addEventListener('input', (e) => {\n        drawScene(e.target.value);\n    });\n\n    // Initial draw\n    drawScene(treeSlider.value);\n</script>\n\n</body>\n</html>",
