                                            "points": [
                                                {
                                                    "symbol": "➡️",
                                                    "text": "<p dir=\"ltr\">&#3381;&#3384;&#3405;&#3364;&#3393;&#3349;&#3405;&#3349;&#3379;&#3398; &#3384;&#3393;&#3364;&#3390;&#3376;&#3405;&#3375;&#3381;&#3384;&#3405;&#3364;&#3393;&#3349;&#3405;&#3349;&#3454;, &#3333;&#3452;&#3366;&#3405;&#3367;&#3364;&#3390;&#3376;&#3405;&#3375;&#3381;&#3384;&#3405;&#3364;&#3393;&#3349;&#3405;&#3349;&#3454;, &#3333;&#3364;&#3390;&#3376;&#3405;&#3375;&#3381;&#3384;&#3405;&#3364;&#3393;&#3349;&#3405;&#3349;&#3454; &#3342;&#3368;&#3405;&#3368;&#3391;&#3353;&#3405;&#3353;&#3368;&#3398; &#3364;&#3376;&#3330;&#3364;&#3391;&#3376;&#3391;&#3349;&#3405;&#3349;&#3390;&#3451; &#3349;&#3380;&#3391;&#3375;&#3393;&#3368;&#3405;&#3368;&#3393;.<br>\n<\/p>\n<p dir=\"ltr\"><br>\n<\/p>"
                                                },
                                                {
                                                    "symbol": "➡️",
                                                    "text": "<p dir=\"ltr\">&#3370;&#3405;&#3376;&#3349;&#3390;&#3382;&#3364;&#3405;&#3364;&#3391;&#3368;&#3405;&#3377;&#3398; &#3370;&#3405;&#3376;&#3364;&#3391;&#3370;&#3364;&#3368;&#3330; (Reflection) &#3342;&#3368;&#3405;&#3364;&#3390;&#3363;&#3398;&#3368;&#3405;&#3368;&#3405; &#3364;&#3391;&#3376;&#3391;&#3354;&#3405;&#3354;&#3377;&#3391;&#3375;&#3393;&#3368;&#3405;&#3368;&#3393;.<br>\n<\/p>\n<p dir=\"ltr\"><br>\n<\/p>"
                                                },
                                                {
                                                    "symbol": "➡️",
                                                    "text": "<p dir=\"ltr\">&#8203;&#3349;&#3405;&#3376;&#3374;&#3370;&#3405;&#3376;&#3364;&#3391;&#3370;&#3364;&#3368;&#3330; (Regular Reflection), &#3381;&#3391;&#3384;&#3376;&#3391;&#3364; &#3370;&#3405;&#3376;&#3364;&#3391;&#3370;&#3364;&#3368;&#3330; (Diffused Reflection) &#3342;&#3368;&#3405;&#3368;&#3391;&#3381;&#3375;&#3391;&#3378;&#3398; &#3381;&#3405;&#3375;&#3364;&#3405;&#3375;&#3390;&#3384;&#3330; &#3374;&#3368;&#3384;&#3405;&#3384;&#3391;&#3378;&#3390;&#3349;&#3405;&#3349;&#3393;&#3368;&#3405;&#3368;&#3393;.<br>\n<\/p>\n<p dir=\"ltr\"><br>\n<\/p>"
                                                },
                                                {
                                                    "symbol": "➡️",
                                                    "text": "<p dir=\"ltr\">&#3370;&#3405;&#3376;&#3364;&#3391;&#3370;&#3364;&#3368; &#3368;&#3391;&#3375;&#3374;&#3353;&#3405;&#3353;&#3454; (Laws of Reflection) &#3370;&#3376;&#3392;&#3349;&#3405;&#3383;&#3363;&#3364;&#3405;&#3364;&#3391;&#3378;&#3394;&#3359;&#3398; &#3364;&#3398;&#3379;&#3391;&#3375;&#3391;&#3349;&#3405;&#3349;&#3393;&#3368;&#3405;&#3368;&#3393;.<br>\n<\/p>\n<p dir=\"ltr\"><br>\n<\/p>"
                                                },
                                                {
                                                    "symbol": "➡️",
                                                    "text": "<p dir=\"ltr\">&#3384;&#3374;&#3364;&#3378; &#3366;&#3452;&#3370;&#3405;&#3370;&#3363;&#3364;&#3405;&#3364;&#3391;&#3453; &#3370;&#3405;&#3376;&#3364;&#3391;&#3372;&#3391;&#3330;&#3372;&#3330; &#3376;&#3394;&#3370;&#3370;&#3405;&#3370;&#3398;&#3359;&#3393;&#3368;&#3405;&#3368; &#3376;&#3392;&#3364;&#3391;&#3375;&#3393;&#3330; &#3333;&#3364;&#3391;&#3368;&#3405;&#3377;&#3398; &#3370;&#3405;&#3376;&#3364;&#3405;&#3375;&#3399;&#3349;&#3364;&#3349;&#3379;&#3393;&#3330; &#3364;&#3391;&#3376;&#3391;&#3354;&#3405;&#3354;&#3377;&#3391;&#3375;&#3393;&#3368;&#3405;&#3368;&#3393;.<br>\n<\/p>\n<p dir=\"ltr\"><br>\n<\/p>"
                                                },
                                                {
                                                    "symbol": "➡️",
                                                    "text": "<p dir=\"ltr\">&#3370;&#3390;&#3452;&#3382;&#3405;&#3381;&#3391;&#3349; &#3381;&#3391;&#3370;&#3376;&#3405;&#3375;&#3375;&#3330; (Lateral Inversion) &#3342;&#3368;&#3405;&#3364;&#3390;&#3363;&#3398;&#3368;&#3405;&#3368;&#3405; &#3374;&#3368;&#3384;&#3405;&#3384;&#3391;&#3378;&#3390;&#3349;&#3405;&#3349;&#3393;&#3368;&#3405;&#3368;&#3393;.<br>\n<\/p>\n<p dir=\"ltr\"><br>\n<\/p>"
                                                },
                                                {
                                                    "symbol": "➡️",
                                                    "text": "<p dir=\"ltr\">&#3334;&#3381;&#3452;&#3364;&#3405;&#3364;&#3368; &#3370;&#3405;&#3376;&#3364;&#3391;&#3370;&#3364;&#3368;&#3330; (Multiple Reflection) &#3370;&#3405;&#3376;&#3375;&#3403;&#3356;&#3368;&#3370;&#3405;&#3370;&#3398;&#3359;&#3393;&#3364;&#3405;&#3364;&#3393;&#3368;&#3405;&#3368; &#3337;&#3370;&#3349;&#3376;&#3363;&#3353;&#3405;&#3353;&#3454; (&#3349;&#3390;&#3378;&#3391;&#3361;&#3403;&#3384;&#3405;&#3349;&#3403;&#3370;&#3405;&#3370;&#3405;, &#3370;&#3398;&#3376;&#3391;&#3384;&#3405;&#3349;&#3403;&#3370;&#3405;&#3370;&#3405;) &#3368;&#3391;&#3452;&#3374;&#3405;&#3374;&#3391;&#3349;&#3405;&#3349;&#3390;&#3451; &#3349;&#3380;&#3391;&#3375;&#3393;&#3368;&#3405;&#3368;&#3393;.<br>\n<\/p>\n<p dir=\"ltr\"><br>\n<\/p>"
                                                },
