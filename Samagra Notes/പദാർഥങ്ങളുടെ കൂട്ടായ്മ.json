            "isTextUnderlined": false,
            "borderRadius": 5
        },
        {
            "type": "PARAGRAPH",
            "content": "[{\"text\":\"📌  ചുറ്റുപാടുകളിൽ നിന്ന് വിവിധതരം മിശ്രിതങ്ങളുടെ പട്ടിക തയ്യാറാക്കുക.\\n📌  നൽകിയിരിക്കുന്ന മിശ്രിതങ്ങൾ ഏകാത്മകമാണോ ഭിന്നാത്മകമാണോ എന്ന് തിരിച്ചറിഞ്ഞ് കുറിപ്പ് തയ്യാറാക്കുക (ഉദാ: കമ്പോസ്റ്റ് വളം, കോൺക്രീറ്റ്, മിക്സ്‌ചർ).\\n📌  ലായനികളിലെ ലീനം, ലായകം എന്നിവ കണ്ടെത്താനുള്ള പ്രവർത്തനങ്ങളിൽ ഏർപ്പെടുക.\"}]",
            "fontSize": 11,
            "fontPath": "fonts\/MLU-Shree.ttf",
            "textColor": "#000000",
            "backgroundColor": "#FFFFFF",
            "borderColor": "#FFFFFF",
            "textAlignment": "LEFT",
            "isUnderlined": false,
            "isTextUnderlined": false
        },
        {
            "type": "TITLE",
            "content": "[{\"text\":\"ലെസൺ പ്ലാൻ\"}]",
