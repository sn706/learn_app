            "borderRadius": 10
        },
        {
            "type": "TITLE",
            "content": "[{\"text\":\"യൂണിറ്റ് പ്ലാൻ\"}]",
            "fontSize": 22,
            "fontPath": "fonts\/MLU-Indulekha Black.ttf",
            "textColor": "#B71C1C",
            "backgroundColor": "#FFFFFF",
            "borderColor": "#FFFFFF",
            "textAlignment": "CENTER",
            "isUnderlined": true,
            "isTextUnderlined": false
        },
        {
            "type": "SUBTITLE",
            "content": "[{\"text\":\"യൂണിറ്റിന്റെ ആശയപരമായ സവിശേഷതകൾ\"}]",
            "fontSize": 14,
            "fontPath": "fonts\/MLU-Shree Bold.ttf",
            "textColor": "#212121",
            "backgroundColor": "#FFFFFF",
            "borderColor": "#212121",
            "textAlignment": "LEFT",
            "isUnderlined": false,
            "isTextUnderlined": false,
            "borderRadius": 5
        },
        {
            "type": "PARAGRAPH",
            "content": "[{\"text\":\"നാം നിത്യജീവിതത്തിൽ ഉപയോഗിക്കുന്ന പല വസ്തുക്കളും ഒന്നിലധികം ഘടകങ്ങൾ ചേർന്നുള്ളവയാണ്. സാലഡ്, മാങ്ങ അച്ചാർ, കോൺക്രീറ്റ്, കമ്പോസ്റ്റ്, മിക്സ്‌ചർ തുടങ്ങിയവ ഉദാഹരണങ്ങളാണ്. ഒന്നിലധികം വസ്തുക്കൾ ചേർന്നുണ്ടാകുന്ന ഇത്തരം പദാർഥങ്ങളെ 'മിശ്രിതങ്ങൾ' എന്ന് വിളിക്കുന്നു. ഈ യൂണിറ്റിലൂടെ മിശ്രിതങ്ങൾ, ലായനികൾ, അവയുടെ വിവിധ തരങ്ങൾ, ഏകാത്മക - ഭിന്നാത്മക മിശ്രിതങ്ങൾ എന്നിവ കുട്ടികൾ പരീക്ഷണങ്ങളിലൂടെ മനസ്സിലാക്കുന്നു.\"}]",
            "fontSize": 11,
            "fontPath": "fonts\/MLU-Shree.ttf",
            "textColor": "#000000",
            "backgroundColor": "#FFFFFF",
            "borderColor": "#FFFFFF",
            "textAlignment": "LEFT",
            "isUnderlined": false,
            "isTextUnderlined": false
        },
        {
            "type": "SUBTITLE",
            "content": "[{\"text\":\"പഠനനേട്ടങ്ങൾ\"}]",
            "fontSize": 14,
            "fontPath": "fonts\/MLU-Shree Bold.ttf",
            "textColor": "#212121",
            "backgroundColor": "#FFFFFF",
            "borderColor": "#212121",
            "textAlignment": "LEFT",
            "isUnderlined": false,
            "isTextUnderlined": false,
            "borderRadius": 5
        },
        {
            "type": "PARAGRAPH",
            "content": "[{\"text\":\"• മിശ്രിതങ്ങൾ എന്നാൽ എന്താണെന്ന് തിരിച്ചറിയാനും ഉദാഹരണങ്ങൾ നൽകാനും കഴിയുന്നു.\\n• ചുറ്റുപാടുകളിൽ കാണുന്ന വിവിധതരം മിശ്രിതങ്ങളും അവയുടെ ഘടകങ്ങളും കണ്ടെത്തുന്നു.\\n• പരീക്ഷണങ്ങളിലൂടെ വിവിധതരം മിശ്രിതങ്ങളും ലായനികളും നിർമ്മിക്കുന്നു.\\n• ഖര-ദ്രാവക, ദ്രാവക-ദ്രാവക, വാതക-ദ്രാവക, ഖര-ഖര ലായനികളെക്കുറിച്ച് തിരിച്ചറിയുന്നു.\\n • ഏകാത്മക മിശ്രിതങ്ങളും (\"},{\"text\":\"Homogeneous mixtures\",\"font\":\"fonts\\\/Calibri.ttf\"},{\"text\":\") ഭിന്നാത്മക മിശ്രിതങ്ങളും (\"},{\"text\":\"Heterogeneous mixtures\",\"font\":\"fonts\\\/Calibri.ttf\"},{\"text\":\") തമ്മിലുള്ള വ്യത്യാസം മനസ്സിലാക്കുന്നു.\"}]",
            "fontSize": 11,
            "fontPath": "fonts\/MLU-Shree.ttf",
            "textColor": "#000000",
            "backgroundColor": "#FFFFFF",
            "borderColor": "#FFFFFF",
            "textAlignment": "LEFT",
            "isUnderlined": false,
            "isTextUnderlined": false
        },
        {
            "type": "SUBTITLE",
            "content": "[{\"text\":\"ആവശ്യമായ സാമഗ്രികൾ \"}]",
            "fontSize": 14,
            "fontPath": "fonts\/MLU-Shree Bold.ttf",
            "textColor": "#212121",
            "backgroundColor": "#FFFFFF",
            "borderColor": "#212121",
            "textAlignment": "LEFT",
            "isUnderlined": false,
            "isTextUnderlined": false,
            "borderRadius": 5
        },
        {
            "type": "PARAGRAPH",
            "content": "[{\"text\":\"• പാഠപുസ്തകം, നോട്ടുബുക്ക്\\n• സുതാര്യമായ പാത്രങ്ങൾ, ചില്ലുഗ്ലാസുകൾ, സ്പൂണുകൾ\\n• വെള്ളം, ഉപ്പ്, പഞ്ചസാര, ചോക്കുപൊടി, നാരങ്ങ, തുരിശ്, പൊട്ടാസ്യം പെർമാംഗനേറ്റ്, ഇരുമ്പുപൊടി, റവ, പയർ, കടല, നെല്ല്.\"}]",
            "fontSize": 11,
            "fontPath": "fonts\/MLU-Shree.ttf",
            "textColor": "#000000",
            "backgroundColor": "#FFFFFF",
            "borderColor": "#FFFFFF",
            "textAlignment": "LEFT",
            "isUnderlined": false,
            "isTextUnderlined": false
        },
        {
            "type": "SUBTITLE",
            "content": "[{\"text\":\"പ്രധാന ആശയങ്ങൾ\"}]",
            "fontSize": 14,
            "fontPath": "fonts\/MLU-Shree Bold.ttf",
            "textColor": "#212121",
            "backgroundColor": "#FFFFFF",
            "borderColor": "#212121",
            "textAlignment": "LEFT",
            "isUnderlined": false,
            "isTextUnderlined": false,
            "borderRadius": 5
        },
        {
            "type": "PARAGRAPH",
            "content": "[{\"text\":\"1. \"},{\"text\":\"മിശ്രിതങ്ങൾ (\",\"bold\":true},{\"text\":\"Mixtures\",\"bold\":true,\"font\":\"fonts\\\/Calibri.ttf\"},{\"text\":\"):\",\"bold\":true},{\"text\":\" ഒന്നിലധികം വസ്തുക്കൾ ചേർന്നുണ്ടാകുന്ന പദാർഥങ്ങൾ. (ഉദാ: സാലഡ്, മിക്സ്‌ചർ, കോൺക്രീറ്റ്).\\n2. \"},{\"text\":\"ലായനികൾ (\",\"bold\":true},{\"text\":\"Solutions\",\"bold\":true,\"font\":\"fonts\\\/Calibri.ttf\"},{\"text\":\"):\",\"bold\":true},{\"text\":\" ഒരു പദാർഥം മറ്റൊന്നിൽ അലിഞ്ഞുചേർന്നുണ്ടാകുന്ന മിശ്രിതങ്ങൾ.\\n•   \"},{\"text\":\"ഖര-ദ്രാവക ലായനി\",\"underline\":true},{\"text\":\" (ഉദാ: ഉപ്പുവെള്ളം, പൊട്ടാസ്യം പെർമാംഗനേറ്റ് ലായനി)\\n• \"},{\"text\":\"ദ്രാവക-ദ്രാവക ലായനി\",\"underline\":true},{\"text\":\" (ഉദാ: വിനാഗിരി വെള്ളം)\\n• \"},{\"text\":\"വാതക-ദ്രാവക ലായനി\",\"underline\":true},{\"text\":\" (ഉദാ: സോഡാവെള്ളം)\\n• \"},{\"text\":\"ഖര-ഖര ലായനി\",\"underline\":true},{\"text\":\" (ഉദാ: ലോഹസങ്കരങ്ങളായ പിച്ചള, വെങ്കലം, 916 സ്വർണം)\\n3.\"},{\"text\":\"ഏകാത്മക മിശ്രിതങ്ങൾ (\",\"bold\":true},{\"text\":\"Homogeneous mixtures\",\"bold\":true,\"font\":\"fonts\\\/Calibri.ttf\"},{\"text\":\"): \",\"bold\":true},{\"text\":\"മിശ്രിതത്തിന്റെ എല്ലാ ഭാഗത്തും ഒരേ സ്വഭാവമുള്ളവ. (ഉദാ: നന്നായി ഇളക്കിയ പഞ്ചസാര ലായനി).\\n4. \"},{\"text\":\"ഭിന്നാത്മക മിശ്രിതങ്ങൾ (\",\"bold\":true},{\"text\":\"Heterogeneous mixtures\",\"bold\":true,\"font\":\"fonts\\\/Calibri.ttf\"},{\"text\":\"):\",\"bold\":true},{\"text\":\" മിശ്രിതത്തിന്റെ വിവിധ ഭാഗങ്ങളിൽ വ്യത്യസ്ത സ്വഭാവമുള്ളവ. (ഉദാ: ചോക്കുപൊടി കലർത്തിയ വെള്ളം, ഇളക്കി അലിയിക്കാത്ത പഞ്ചസാരവെള്ളം).\"}]",
            "fontSize": 11,
            "fontPath": "fonts\/MLU-Shree.ttf",
            "textColor": "#000000",
            "backgroundColor": "#FFFFFF",
            "borderColor": "#FFFFFF",
            "textAlignment": "LEFT",
            "isUnderlined": false,
            "isTextUnderlined": false
        },
        {
            "type": "SUBTITLE",
            "content": "[{\"text\":\"പഠന പ്രവർത്തനങ്ങൾ\"}]",
            "fontSize": 14,
            "fontPath": "fonts\/MLU-Shree Bold.ttf",
            "textColor": "#212121",
            "backgroundColor": "#FFFFFF",
            "borderColor": "#212121",
            "textAlignment": "LEFT",
            "isUnderlined": false,
            "isTextUnderlined": false,
            "borderRadius": 5
        },
        {
            "type": "PARAGRAPH",
            "content": "[{\"text\":\"പ്രവർത്തനം 1 - സാലഡ് നിർമ്മാണവും ചർച്ചയും:\",\"bold\":true},{\"text\":\"\\nഉള്ളി, തക്കാളി, ഉപ്പ് എന്നിവ ചേർത്ത് സാലഡ് ഉണ്ടാക്കുന്നതിലൂടെ ഒന്നിലധികം ഘടകങ്ങൾ ചേർന്നുള്ള പദാർഥങ്ങളെക്കുറിച്ചുള്ള ആശയം രൂപീകരിക്കുന്നു. മാങ്ങ അച്ചാർ, കോൺക്രീറ്റ് എന്നിവയും ചർച്ച ചെയ്യുന്നു.\\n\\n\"},{\"text\":\"പ്രവർത്തനം 2 - മിശ്രിതങ്ങൾ നിർമ്മിക്കൽ:\",\"bold\":true},{\"text\":\"\\nശാസ്ത്രകിറ്റിലെ സാമഗ്രികളും മറ്റ് വസ്തുക്കളും ഉപയോഗിച്ച് കുട്ടികൾ ഗ്രൂപ്പുകളായി വിവിധ മിശ്രിതങ്ങൾ ഉണ്ടാക്കുന്നു (ഉദാ: ഉപ്പുവെള്ളം, റവയും ഉപ്പും ചേർന്നത്).\\n\\n\"},{\"text\":\"പ്രവർത്തനം 3 - ലായനികളുടെ വൈവിധ്യം കണ്ടെത്തൽ:\",\"bold\":true},{\"text\":\"\\nഖരം, ദ്രാവകം, വാതകം എന്നിവ ലയിച്ചുണ്ടാകുന്ന വിവിധതരം ലായനികളെപ്പറ്റിയും ലോഹസങ്കരങ്ങളെപ്പറ്റിയും (916 സ്വർണം, പിച്ചള) അധികവായനയിലൂടെ മനസ്സിലാക്കുന്നു.\\n\\n\"},{\"text\":\"പ്രവർത്തനം 4 - രുചി പരിശോധനയും ഏകാത്മക\\\/ഭിന്നാത്മക മിശ്രിതങ്ങളും:\",\"bold\":true},{\"text\":\"\\nഇളക്കി ചേർത്ത പഞ്ചസാര ലായനിയും ഇളക്കി ചേർക്കാത്ത പഞ്ചസാര വെള്ളവും പരീക്ഷിച്ച് രുചിയിലെ വ്യത്യാസം കണ്ടെത്തുന്നു. ഇതിലൂടെ ഏകാത്മക മിശ്രിതങ്ങളും ഭിന്നാത്മക മിശ്രിതങ്ങളും വേർതിരിച്ചറിയുന്നു.\"}]",
            "fontSize": 11,
            "fontPath": "fonts\/MLU-Shree.ttf",
            "textColor": "#000000",
            "backgroundColor": "#FFFFFF",
            "borderColor": "#FFFFFF",
            "textAlignment": "LEFT",
            "isUnderlined": false,
            "isTextUnderlined": false
        },
        {
            "type": "SUBTITLE",
            "content": "[{\"text\":\"തുടരന്വേഷണ പ്രവർത്തനങ്ങൾ \\\/ വിലയിരുത്തൽ\"}]",
            "fontSize": 14,
            "fontPath": "fonts\/MLU-Shree Bold.ttf",
            "textColor": "#212121",
            "backgroundColor": "#FFFFFF",
            "borderColor": "#212121",
            "textAlignment": "LEFT",
