            "isTextUnderlined": false,
            "borderRadius": 10
        },
        {
            "type": "SUBTITLE",
            "content": "[{\"text\":\"പ്രധാന ആശയങ്ങൾ\"}]",
            "fontSize": 14,
            "fontPath": "fonts\/MLU-Mohini Bold.ttf",
            "textColor": "#000000",
